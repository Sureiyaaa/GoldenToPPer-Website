# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Cloudflare Turnstile Configuration - Admin Login
# Public key: Safe to expose on frontend; identifies the CAPTCHA widget
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=

# Secret key: MUST remain server-side only; never expose to client
# Used by loginAction() server function to verify CAPTCHA tokens
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Cloudflare Turnstile Configuration - Payment Form
# SEPARATE from Admin Login keys; isolates Admin and Payment verification
# Public key: Safe to expose on frontend; identifies the CAPTCHA widget
NEXT_PUBLIC_PAYMENT_TURNSTILE_SITE_KEY=

# Secret key: MUST remain server-side only; never expose to client
# Used by submitPaymentAction() server function to verify CAPTCHA tokens
PAYMENT_TURNSTILE_SECRET_KEY=
