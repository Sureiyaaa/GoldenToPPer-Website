# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Admin login automatically trusts Vercel's x-vercel-forwarded-for header.
# For other production hosts, set a header your trusted ingress OVERWRITES with
# one client IP and prevent direct access to the app server. Never trust a header
# merely forwarded from the browser. Missing/invalid trusted IPs block login.
# Local development uses one shared bucket when this is unset.
ADMIN_LOGIN_IP_HEADER=

# Cloudflare Turnstile Configuration
# Public key: Safe to expose on frontend; identifies the CAPTCHA widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key: MUST remain server-side only; never expose to client
# Used by server functions to verify CAPTCHA tokens
TURNSTILE_SECRET_KEY=

# Optional exact hostname allowlist for loan, inquiry and contact verification.
# Defaults to goldentopper.vercel.app,www.goldentopper.vercel.app.
# Add your custom production domain here if you use one (comma-separated, no URL scheme).
TURNSTILE_ALLOWED_HOSTNAMES=

# Environment-specific configurations:
# .env.development - Uses development Turnstile keys
# .env.production - Uses production Turnstile keys
# .env.local - Local overrides (for local development)

# Paynamics Payment Gateway Configuration
# Sandbox vs production is picked by which .env file is loaded, same as Turnstile
# above. Use the Paynamics-issued URL for this merchant account/environment.
PAYNAMICS_BASE_URL=

# Secret key: MUST remain server-side only; used to sign every request (SHA-512)
# and to verify callback signatures. Never expose to client.
PAYNAMICS_MKEY=

# Paygate account hash (Header Authentication, per Paynamics spec 2.3A).
# Separate from PAYNAMICS_MKEY, which only signs the transaction payload — this
# is the already base64-encoded "username:password" account hash sent as-is in
# Authorization: Basic <this value>. MUST remain server-side only.
PAYNAMICS_AUTH_KEY=

# notification_url/response_url/cancel_url sent to Paynamics are derived
# automatically from NEXT_PUBLIC_SITE_URL (see app/projects/[slug]/page.tsx for
# the same pattern) as /api/paynamics/notification and /api/paynamics/callback.
# Nothing to set here — just make sure NEXT_PUBLIC_SITE_URL is correct per env.

# Optional: after verifying a notification_url push, forward the raw payload
# here (e.g. an n8n webhook) for downstream processing. Leave blank to skip.
PAYNAMICS_NOTIFICATION_FORWARD_URL=

# /api/paynamics/callback redirects the browser to NEXT_PUBLIC_SITE_URL +
# /payment/success or /payment/failed after a verified response — nothing to
# set here either, as long as those pages exist on this site.
